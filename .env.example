# Optional server-side Shopify connection for /api/shopify.
# The website uses the public token in shopify-storefront.mjs and does not need these.
# Private tokens must remain server-only and must never be committed.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Optional: use a server-only private Storefront token instead of the public token above.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# Product handles. Defaults shown below match the storefront code.
SHOPIFY_TEE_HANDLE=bayley-currey-racing-t-shirt
SHOPIFY_HOODIE_HANDLE=bayley-currey-racing-hoodie
SHOPIFY_HAT_HANDLE=bayley-currey-racing-hat
